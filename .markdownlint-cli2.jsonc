{
  "config": {
    // Line length: disabled (managed manually)
    "MD013": false,

    // Allow duplicate headings in different sections
    "MD024": { "siblings_only": true },

    // Allow inline HTML (needed for <br>, <details>, <kbd>, etc.)
    "MD033": false,

    // Allow bare URLs without angle brackets
    "MD034": false,

    // Allow files without top-level heading (Copilot instructions, PR template, reviews)
    "MD041": false,

    // Table column style: disabled. Prettier owns table alignment and fixes it
    // automatically; markdownlint has no fixer for this rule, and its default
    // "any" style reports against whichever style is the closest match, which
    // pushes a nearly-aligned table toward compact.
    "MD060": false
  },

  // Files to ignore
  "ignores": ["CHANGELOG.md", "tests/**"]
}
